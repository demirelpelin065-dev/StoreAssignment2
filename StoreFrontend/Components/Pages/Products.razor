@page "/products"
@rendermode InteractiveServer
@using System.Net.Http.Json
@using StoreFrontend.Models
@inject IHttpClientFactory HttpClientFactory

<PageTitle>Products</PageTitle>

<h1>Products</h1>

@if (!string.IsNullOrWhiteSpace(errorMessage))
{
    <div class="alert alert-danger">
        @errorMessage
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h4>@(editingId == 0 ? "Add product" : "Edit product")</h4>

        <EditForm Model="formModel" OnValidSubmit="SaveProduct">
            <DataAnnotationsValidator />
            <ValidationSummary />

            <div class="mb-3">
                <label class="form-label">Name</label>
                <InputText class="form-control" @bind-Value="formModel.Name" />
            </div>

            <div class="mb-3">
                <label class="form-label">Description</label>
                <InputText class="form-control" @bind-Value="formModel.Description" />
            </div>

            <div class="mb-3">
                <label class="form-label">Price</label>
                <InputNumber class="form-control" @bind-Value="formModel.Price" />
            </div>

            <div class="mb-3">
                <label class="form-label">Category</label>

                <InputSelect class="form-select" @bind-Value="formModel.CategoryId">
                    <option value="0">Choose category</option>

                    @foreach (var category in categories)
                    {
                        <option value="@category.Id">@category.Name</option>
                    }
                </InputSelect>
            </div>

            <button class="btn btn-primary" type="submit">
                @(editingId == 0 ? "Create" : "Update")
            </button>

            @if (editingId != 0)
            {
                <button class="btn btn-secondary ms-2"
                        type="button"
                        @onclick="CancelEdit">
                    Cancel
                </button>
            }
        </EditForm>
    </div>
</div>

@if (products.Count == 0)
{
    <p>No products found.</p>
}
else
{
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Name</th>
                <th>Description</th>
                <th>Price</th>
                <th>Category</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var product in products)
            {
                <tr>
                    <td>@product.Name</td>
                    <td>@product.Description</td>
                    <td>@product.Price.ToString("0.00")</td>
                    <td>@product.CategoryName</td>

                    <td>
                        <button class="btn btn-sm btn-warning me-2"
                                @onclick="() => StartEdit(product)">
                            Edit
                        </button>

                        <button class="btn btn-sm btn-danger"
                                @onclick="() => DeleteProduct(product.Id)">
                            Delete
                        </button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    private readonly List<ProductModel> products = new();
    private readonly List<CategoryModel> categories = new();

    private ProductModel formModel = new();

    private int editingId;

    private string? errorMessage;

    private HttpClient Api =>
        HttpClientFactory.CreateClient("StoreApi");

    protected override async Task OnInitializedAsync()
    {
        await LoadData();
    }

    private async Task LoadData()
    {
        errorMessage = null;

        try
        {
            var loadedProducts =
                await Api.GetFromJsonAsync<List<ProductModel>>("api/Products");

            var loadedCategories =
                await Api.GetFromJsonAsync<List<CategoryModel>>("api/Categories");

            products.Clear();
            categories.Clear();

            if (loadedProducts is not null)
                products.AddRange(loadedProducts);

            if (loadedCategories is not null)
                categories.AddRange(loadedCategories);
        }
        catch
        {
            errorMessage =
                "Could not connect to the API. Make sure StoreApi is running.";
        }
    }

    private async Task SaveProduct()
    {
        errorMessage = null;

        try
        {
            HttpResponseMessage response;

            if (editingId == 0)
            {
                response =
                    await Api.PostAsJsonAsync("api/Products", formModel);
            }
            else
            {
                response =
                    await Api.PutAsJsonAsync(
                        $"api/Products/{editingId}",
                        formModel);
            }

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Could not save the product.";
                return;
            }

            CancelEdit();
            await LoadData();
        }
        catch
        {
            errorMessage = "Could not connect to the API.";
        }
    }

    private void StartEdit(ProductModel product)
    {
        editingId = product.Id;

        formModel = new ProductModel
        {
            Id = product.Id,
            Name = product.Name,
            Description = product.Description,
            Price = product.Price,
            CategoryId = product.CategoryId,
            CategoryName = product.CategoryName
        };
    }

    private void CancelEdit()
    {
        editingId = 0;
        formModel = new ProductModel();
    }

    private async Task DeleteProduct(int id)
    {
        errorMessage = null;

        try
        {
            var response =
                await Api.DeleteAsync($"api/Products/{id}");

            if (!response.IsSuccessStatusCode)
            {
                errorMessage = "Could not delete the product.";
                return;
            }

            await LoadData();
        }
        catch
        {
            errorMessage = "Could not connect to the API.";
        }
    }
}
